{
  "_doc": "Each model has a list of routes. The harness uses the first route whose key variable is set, unless --route forces one. Every record stores the route that was used.",
  "providers": {
    "freellmapi": {"kind": "openai", "base_url": "http://localhost:3001/v1", "key_env": "FREELLMAPI_API_KEY", "concurrency": 3},
    "github":     {"kind": "openai", "base_url": "https://models.github.ai/inference", "key_env": "GITHUB_TOKEN", "concurrency": 2},
    "gemini":     {"kind": "openai", "base_url": "https://generativelanguage.googleapis.com/v1beta/openai", "key_env": "GEMINI_API_KEY", "concurrency": 3},
    "groq":       {"kind": "openai", "base_url": "https://api.groq.com/openai/v1", "key_env": "GROQ_API_KEY", "concurrency": 2},
    "mistral":    {"kind": "openai", "base_url": "https://api.mistral.ai/v1", "key_env": "MISTRAL_API_KEY", "concurrency": 1},
    "nvidia":     {"kind": "openai", "base_url": "https://integrate.api.nvidia.com/v1", "key_env": "NVIDIA_NIM_API_KEY", "concurrency": 4},
    "openrouter": {"kind": "openai", "base_url": "https://openrouter.ai/api/v1", "key_env": "OPENROUTER_API_KEY", "concurrency": 2},
    "claude_cli": {"kind": "cli", "key_env": null, "concurrency": 3, "prompt_via": "stdin",
                   "cmd": ["claude", "-p", "--model", "{model}", "--system-prompt", "{system}", "--tools", "", "--output-format", "text", "--no-session-persistence", "--strict-mcp-config", "--setting-sources", ""]},
    "opencode_cli": {"kind": "cli", "key_env": null, "concurrency": 2, "prompt_via": "arg",
                   "cmd": ["opencode", "run", "-m", "{model}", "{system}\n\n{prompt}"]},
    "codex_cli":  {"kind": "cli", "key_env": null, "concurrency": 2, "prompt_via": "stdin",
                   "cmd": ["codex", "exec", "--skip-git-repo-check", "-m", "{model}", "-"]}
  },
  "subjects": {
    "gpt41":         [{"provider": "github", "model": "openai/gpt-4.1"}, {"provider": "freellmapi", "model": "gpt-4.1"}],
    "gemini_flash":  [{"provider": "gemini", "model": "gemini-2.5-flash"}],
    "mistral_large": [{"provider": "mistral", "model": "mistral-large-latest"}, {"provider": "nvidia", "model": "mistralai/mistral-large-2-instruct"}],
    "llama70b":      [{"provider": "groq", "model": "llama-3.3-70b-versatile"}, {"provider": "freellmapi", "model": "llama-3.3-70b"}]
  },
  "graders": {
    "claude_haiku": [{"provider": "claude_cli", "model": "haiku"}],
    "kimi":         [{"provider": "nvidia", "model": "moonshotai/kimi-k2.6"}],
    "deepseek":     [{"provider": "nvidia", "model": "deepseek-ai/deepseek-v4.1-flash"}],
    "codex":        [{"provider": "codex_cli", "model": "gpt-5.4-mini"}],
    "opencode_gemini": [{"provider": "opencode_cli", "model": "google-agy/gemini-3.8-flash"}]
  },
  "default_graders": ["claude_haiku", "kimi", "deepseek"],
  "subject_params": {"temperature": 0.7, "max_tokens": 700},
  "grader_params": {"temperature": 0, "max_tokens": 900}
}
