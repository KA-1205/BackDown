{
  "_doc": "Each model has a list of routes to the SAME model. The harness uses the first route whose key variable is set, unless --route forces one. Every record stores the route used. Subjects: API routes only. CLI routes are grader-only. Probed 2026-11-14.",
  "providers": {
    "freellmapi": {"kind": "openai", "base_url": "http://localhost:3001/v1", "key_env": "FREELLMAPI_API_KEY", "concurrency": 3},
    "gemini":     {"kind": "openai", "base_url": "https://generativelanguage.googleapis.com/v1beta/openai", "key_env": "GEMINI_API_KEY", "concurrency": 3},
    "groq":       {"kind": "openai", "base_url": "https://api.groq.com/openai/v1", "key_env": "GROQ_API_KEY", "concurrency": 2},
    "groq2":      {"kind": "openai", "base_url": "https://api.groq.com/openai/v1", "key_env": "OPENCODE_GROQ_API_KEY", "concurrency": 2},
    "mistral":    {"kind": "openai", "base_url": "https://api.mistral.ai/v1", "key_env": "MISTRAL_API_KEY", "concurrency": 1},
    "nvidia":     {"kind": "openai", "base_url": "https://integrate.api.nvidia.com/v1", "key_env": "NVIDIA_NIM_API_KEY", "concurrency": 4},
    "openrouter": {"kind": "openai", "base_url": "https://openrouter.ai/api/v1", "key_env": "OPENROUTER_API_KEY", "concurrency": 10,
                   "spend_stop_env": "OPENROUTER_STOP_AT_USD"},
    "claude_cli": {"kind": "cli", "key_env": null, "concurrency": 3, "prompt_via": "stdin",
                   "cmd": ["claude", "-p", "--model", "{model}", "--system-prompt", "{system}", "--tools", "", "--output-format", "text", "--no-session-persistence", "--strict-mcp-config", "--setting-sources", ""]},
    "opencode_cli": {"kind": "cli", "key_env": null, "concurrency": 4, "prompt_via": "arg",
                   "cmd": ["opencode", "run", "--agent", "plan", "--archived", "-m", "{model}", "-f", "{prompt_file}", "{system} Your full task is in the attached file. Follow it exactly and reply with only the JSON object it asks for."]},
    "codex_cli":  {"kind": "cli", "key_env": null, "concurrency": 3, "prompt_via": "stdin",
                   "cmd": ["codex", "exec", "--skip-git-repo-check", "--sandbox", "read-only", "-c", "model_reasoning_effort=low", "-m", "{model}", "-"]}
  },
  "subjects": {
    "gemini_flash":  [{"provider": "gemini", "model": "gemini-3.5-flash"}],
    "mistral_large": [{"provider": "mistral", "model": "mistral-large-2512"}, {"provider": "freellmapi", "model": "mistral-large-3"}],
    "gpt_oss":       [{"provider": "openrouter", "model": "openai/gpt-oss-120b", "extra": {"provider": {"sort": "price"}, "reasoning": {"effort": "medium"}}}, {"provider": "groq", "model": "openai/gpt-oss-120b"}, {"provider": "groq2", "model": "openai/gpt-oss-120b"}],
    "nemotron":      [{"provider": "nvidia", "model": "nvidia/nemotron-3-ultra-550b-a55b"}]
  },
  "graders": {
    "claude_haiku": [{"provider": "claude_cli", "model": "haiku"}],
    "glm":          [{"provider": "openrouter", "model": "z-ai/glm-5.3-flash", "extra": {"reasoning": {"effort": "low"}}}],
    "deepseek":     [{"provider": "openrouter", "model": "deepseek/deepseek-v4.1-flash", "extra": {"reasoning": {"enabled": false}}}],
    "glm_oc":       [{"provider": "opencode_cli", "model": "opencode/glm-5.3-flash-free"}],
    "deepseek_oc":  [{"provider": "opencode_cli", "model": "opencode/deepseek-v4.1-flash-free"}],
    "codex":        [{"provider": "codex_cli", "model": "gpt-5.6-terra"}]
  },
  "default_graders": ["claude_haiku", "codex", "glm_oc"],
  "_grader_note": "All default graders are free CLIs (Claude plan, ChatGPT plan, OpenCode free models). glm and deepseek on OpenRouter are paid backups only; OpenRouter money goes to subject models.",
  "subject_params": {"temperature": 0.7, "max_tokens": 3000},
  "grader_params": {"temperature": 0, "max_tokens": 2500}
}
